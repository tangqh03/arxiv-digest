{
  "summary": {
    "max_length": 800,
    "include_full_abstract": true,
    "include_author_list": true,
    "highlight_repeated": true,
    "repeated_threshold": 2
  },
  "cross_domain": {
    "enabled": true,
    "max_papers": 5,
    "source": "alphaxiv-trending",
    "label": "🔥 跨领域热门"
  },
  "topics": {
    "label": "📌 关注领域"
  },
  "huggingface": {
    "enabled": true,
    "daily_limit": 50,
    "max_papers": 5,
    "label": "🤗 HuggingFace Daily"
  },
  "llm_rerank": {
    "enabled": true,
    "top_k": 10,
    "score_threshold": 7,
    "filter_threshold": 6.0,
    "filter_low_score": true
  },
  "keyword_filter": {
    "enabled": true
  },
  "llm": {
    "temperature": 0.2,
    "timeout_seconds": 120,
    "max_retries": 3
  },
  "screening": {
    "relevance_threshold": 6,
    "max_candidates": 20
  },
  "deep_read": {
    "enabled": true,
    "top_k": 3,
    "min_relevance": 7,
    "max_fulltext_chars": 120000,
    "chunk_chars": 30000,
    "chunk_overlap": 1500
  },
  "delivery": {
    "feishu": {
      "enabled": false,
      "format": "interactive_card",
      "max_papers_per_message": 3
    }
  },
  "cron": {
    "enabled": true,
    "schedule": "0 10 * * *",
    "timezone": "Asia/Singapore"
  },
  "output": {
    "format": "markdown",
    "include_log": true,
    "channel": "webchat"
  }
}
